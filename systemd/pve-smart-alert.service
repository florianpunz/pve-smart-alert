#
# One run of the drive health check, started by pve-smart-alert.timer
# (ADR 0006). It has no [Install] section: it is never enabled, only started
# by the timer or by hand with `systemctl start pve-smart-alert.service`.
#
# Exit status 3 means that another run holds the lock, which is not a failure
# of this one (FR-605). Every other status but 0 is a failure, status 1
# included, a notification that could not be handed over: the failure unit
# then reports it through a path that does not use the code of the tool.

[Unit]
Description=PVE SMART Alert drive health check
Documentation=https://github.com/florianpunz/pve-smart-alert
# The notification configuration lives on pmxcfs. Ordered after it, but not
# requiring it: without pmxcfs the check runs and the fallback is used.
After=pve-cluster.service
OnFailure=pve-smart-alert-failure.service

[Service]
Type=oneshot
# Runs as root: raw device access needs it (ADR 0025). Retest with ADR 0025
# before adding User=, PrivateDevices=, DeviceAllow= or capability limits.
ExecStart=/usr/sbin/pve-smart-alert check
SuccessExitStatus=3
RuntimeDirectory=pve-smart-alert
RuntimeDirectoryPreserve=yes
StateDirectory=pve-smart-alert
StateDirectoryMode=0700
# Runs cannot pile up on a host with many unresponsive drives (NFR-08).
TimeoutStartSec=15min
# Reduced CPU and I/O priority (NFR-09).
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Sandboxing that was tested on a real host with both transports and a check
# (ADR 0025). The drives under /dev and the mail queue stay reachable.
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
NoNewPrivileges=yes

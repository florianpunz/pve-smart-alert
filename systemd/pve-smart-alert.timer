# Starts the drive health check 3 minutes after boot, then 30 minutes after
# each start (ADR 0006). Both are monotonic, so the first run follows the
# installation; change the interval with `systemctl edit`, not in this file.

[Unit]
Description=PVE SMART Alert drive health check every 30 minutes
Documentation=https://github.com/florianpunz/pve-smart-alert

[Timer]
OnBootSec=3min
OnUnitActiveSec=30min
AccuracySec=1min

[Install]
WantedBy=timers.target

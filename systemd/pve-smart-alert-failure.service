#
# Started through OnFailure= when a run of pve-smart-alert.service fails. It
# reports the failure as mail to root, with a script that uses none of the
# code of the tool, at most once per day (ADR 0009, FR-519).

[Unit]
Description=Report a failed run of the PVE SMART Alert drive health check
Documentation=https://github.com/florianpunz/pve-smart-alert

[Service]
Type=oneshot
ExecStart=/usr/libexec/pve-smart-alert/report-failure
TimeoutStartSec=2min

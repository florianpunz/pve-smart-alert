# Started through OnFailure= of pve-smart-alert.service: at most one plain mail
# to root per day, and once more after a reboot, with a script that does not
# use the code of the tool (ADR 0009).

[Unit]
Description=PVE SMART Alert failure report
Documentation=https://github.com/florianpunz/pve-smart-alert

[Service]
Type=oneshot
ExecStart=/usr/libexec/pve-smart-alert/report-failure
RuntimeDirectory=pve-smart-alert
RuntimeDirectoryPreserve=yes
TimeoutStartSec=2min

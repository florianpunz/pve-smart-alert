#!/usr/bin/make -f
# SPDX-License-Identifier: AGPL-3.0-or-later
# Nothing is configured, built or compiled: debian/pve-smart-alert.install
# places every file, and the Python package is installed as source (ADR 0013).

%:
	dh $@

# None of debhelper's automatic steps applies to this package. With no
# commands below an override target, the original command is not run.
override_dh_auto_clean:
override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_install:

override_dh_install:
	# A development checkout can carry byte code caches next to the source.
	# They never belong in the package, whatever the checkout looked like: the
	# exclusion is what keeps the source tree installable as it is (ADR 0013).
	dh_install --exclude=__pycache__

# Only the timer is named: unnamed, dh_installsystemd would also write start
# snippets for the two services without [Install], and postinst would start a
# check (dh_installsystemd of debhelper 13.24.2, ADR 0006, ADR 0013).
override_dh_installsystemd:
	dh_installsystemd pve-smart-alert.timer

# The reference configuration keeps its path and is larger than 4 KiB, so
# dh_compress would otherwise install it as `config.reference.toml.gz`
# (ADR 0011).
override_dh_compress:
	dh_compress -X.toml

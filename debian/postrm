#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# On purge, removes only the paths of the tool: configuration, state, runtime
# directory and the package directory (ADR 0012, ADR 0035). Everything else
# under /usr and /etc/pve belongs to dpkg.
set -e

case "$1" in
	purge)
		rm -rf /etc/pve-smart-alert /var/lib/pve-smart-alert /run/pve-smart-alert
		# dpkg removes a directory only when it is empty, and a file it does
		# not own keeps it alive: the whole directory goes (ADR 0035).
		rm -rf /usr/share/pve-smart-alert
		;;
esac

#DEBHELPER#

exit 0

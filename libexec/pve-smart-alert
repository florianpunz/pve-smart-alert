#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Launcher of the installed tool, installed as /usr/sbin/pve-smart-alert. It
# imports the package from /usr/share and writes no byte code (ADR 0013); the
# command line is passed through unchanged.
set -eu

PYTHONPATH=/usr/share/pve-smart-alert
PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH PYTHONDONTWRITEBYTECODE

exec python3 -B -m pve_smart_alert "$@"
